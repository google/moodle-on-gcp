
$CFG->enable_read_only_sessions = true;

$CFG->localcachedir = '/tmp/moodle/localcache';

$CFG->slasharguments = true;

if (!empty('$REDIS_LOCK_HOST_AND_PORT') && (is_readable(__DIR__ . '/public/local/redislock/classes/lock/redis_lock_factory.php') || is_readable(__DIR__ . '/local/redislock/classes/lock/redis_lock_factory.php') || class_exists('\\local_redislock\\lock\\redis_lock_factory'))) {
    $CFG->lock_factory = '\\local_redislock\\lock\\redis_lock_factory';
    $CFG->local_redislock_redis_server = '$REDIS_LOCK_HOST_AND_PORT';
    $CFG->local_redislock_redis_auth = '$REDIS_LOCK_AUTH_STRING';
    $CFG->local_redislock_logging = true;
}

// Redis session handler (requires redis server and redis extension):
if (!empty('$REDIS_SESSION_ID_HOST')) {
    $CFG->session_handler_class = '\core\session\redis';
    $CFG->session_redis_host = '$REDIS_SESSION_ID_HOST';
    $CFG->session_redis_port = (int)('$REDIS_SESSION_ID_PORT' ?: 6379);   // Optional, default is 6379.
    $CFG->session_redis_database = 0;                                     // Optional, default is db 0.
    $CFG->session_redis_auth = '$REDIS_SESSION_ID_AUTH_STRING';           // Optional, default is don't set one.
    $CFG->session_redis_prefix = 'mdl_sessid_1_';                         // Optional, default is don't set one.
    $CFG->session_redis_acquire_lock_timeout = 120;                       // Default is 2 minutes.
    $CFG->session_redis_acquire_lock_warn = 0;                            // If set logs early warning if a lock has not been acquired.
    $CFG->session_redis_lock_expire = 7200;                               // Optional, defaults to session timeout.
    $CFG->session_redis_lock_retry = 100;                                 // Optional wait between lock attempts in ms, default is 100.
                                                                          // After 5 seconds it will throttle down to once per second.

    // Use igbinary binary serializer and zstd compression for high-concurrency scaling (~55% smaller payloads, 4x faster than PHP serialize + gzip).
    $CFG->session_redis_serializer_use_igbinary = true;  // Enabled via php83-pecl-igbinary.
    $CFG->session_redis_compressor = 'zstd';             // Enabled via php83-pecl-zstd (possible values: 'none', 'gzip', 'zstd').
}

$CFG->xsendfile = "X-Accel-Redirect";
$CFG->xsendfilealiases = array(
    "/dataroot/" => $CFG->dataroot,
    "/localcachedir/" => $CFG->localcachedir
);
