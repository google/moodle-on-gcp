# Stage 1: Compile preloadable_libiconv.so against current Alpine toolchain
# Addresses MDL-80440 (musl iconv //TRANSLIT limitation) without relying on legacy Alpine v3.13 repos.
FROM alpine:3.21 AS libiconv-builder

COPY ["./scripts/build-gnu-libiconv.sh", "/tmp/build-gnu-libiconv.sh"]
RUN chmod +x /tmp/build-gnu-libiconv.sh && /tmp/build-gnu-libiconv.sh

# Stage 2: Moodle NGINX + PHP 8.3 Runtime Image
FROM alpine:3.21

USER root

COPY --from=libiconv-builder /usr/lib/preloadable_libiconv.so /usr/lib/preloadable_libiconv.so

RUN apk update && apk add --no-cache \
  tar curl gzip unzip git nginx gnu-libiconv-libs \
  php83 php83-fpm php83-opcache \
  php83-mysqli php83-pdo php83-pdo_mysql \
  php83-iconv php83-mbstring php83-curl php83-openssl php83-tokenizer php83-intl \
  php83-soap php83-xmlreader php83-fileinfo php83-sodium php83-exif php83-ctype php83-zip \
  php83-xmlwriter php83-gd php83-simplexml php83-dom php83-xml \
  php83-pecl-redis php83-pecl-igbinary php83-pecl-apcu php83-pecl-zstd \
  php83-phar php83-posix php83-session php83-sockets \
  envsubst tzdata sudo vim icu-data-full \
  && ln -sf /usr/bin/php83 /usr/bin/php \
  && ln -sf /usr/bin/php83 /usr/bin/php81

ENV LD_PRELOAD=/usr/lib/preloadable_libiconv.so

# Verify PHP 8.3 and GNU libiconv //TRANSLIT support at build time
RUN php -r 'if (iconv("UTF-8", "ASCII//TRANSLIT", "Olá") === false) { fwrite(STDERR, "GNU libiconv preload verification failed\n"); exit(1); }'

# Install Composer with dynamic signature verification from getcomposer.org
RUN EXPECTED_CHECKSUM="$(php -r 'copy("https://composer.github.io/installer.sig", "php://stdout");')" && \
  php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" && \
  ACTUAL_CHECKSUM="$(php -r "echo hash_file('sha384', 'composer-setup.php');")" && \
  if [ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]; then \
    >&2 echo 'ERROR: Invalid Composer installer checksum'; \
    rm -fv composer-setup.php; \
    exit 1; \
  fi && \
  php composer-setup.php --quiet --install-dir=/usr/local/bin --filename=composer && \
  rm -fv composer-setup.php

# Optional runtime utilities used by Moodle (document conversion, spellcheck, antivirus, graphviz)
RUN apk add --no-cache aspell graphviz ghostscript python3 poppler-utils clamav

RUN adduser -D -g 'www' www

ARG MOODLE_ROOT_PATH='/moodleroot-instance1' \
    MOODLE_DATAROOT_PATH='/moodleroot-instance1/moodledata' \
    MOODLE_PATH='/moodleroot-instance1/moodle'

ENV MOODLE_URL='' \
    MOODLE_SHA256='' \
    MOOSH_URL='' \
    MOOSH_SHA256='' \
    MOODLE_PLUGINS='report_benchmark tool_opcache' \
    LANG='' \
    LANGUAGE='' \
    MOODLE_LANGUAGE='' \
    SITE_URL='' \
    MOODLE_ROOT_PATH=$MOODLE_ROOT_PATH \
    MOODLE_DATAROOT_PATH=$MOODLE_DATAROOT_PATH \
    MOODLE_PATH=$MOODLE_PATH \
    DB_TYPE='' \
    DB_HOST='' \
    DB_HOST_PORT='' \
    DB_NAME='' \
    DB_USER='' \
    DB_PASS='' \
    DB_PREFIX='' \
    MOODLE_SITENAME='' \
    MOODLE_SITESUMMARY='' \
    MOODLE_USERNAME='' \
    MOODLE_PASSWORD='' \
    MOODLE_EMAIL='' \
    DB_READ_REPLICA_HOST='' \
    DB_READ_REPLICA_PORT='' \
    DB_READ_REPLICA_USER='' \
    DB_READ_REPLICA_PASSWORD='' \
    REDIS_SESSION_ID_HOST="" \
    REDIS_SESSION_ID_PORT="" \
    REDIS_SESSION_ID_AUTH_STRING="" \
    REDIS_APP_IP_AND_PORT="" \
    REDIS_APP_AUTH_STRING="" \
    REDIS_SESSION_IP_AND_PORT="" \
    REDIS_SESSION_AUTH_STRING="" \
    REDIS_LOCK_HOST_AND_PORT="" \
    REDIS_LOCK_AUTH_STRING="" \
    SSLPROXY='' \
    NOEMAIL_EVER='' \
    SMTP_HOST='' \
    SMTP_PORT='' \
    SMTP_USER='' \
    SMTP_PASSWORD='' \
    SMTP_PROTOCOL='' \
    MOODLE_MAIL_NOREPLY_ADDRESS='' \
    MOODLE_MAIL_PREFIX='' \
    PHP_MEMORY_LIMIT='' \
    PHP_UPLOAD_MAX_FILESIZE='' \
    PHP_POST_MAX_SIZE='' \
    NGINX_CLIENT_MAX_BODY_SIZE=''

COPY ["./base/opt", "/opt"]

COPY --chown=root:root ["./base/etc", "/root/etc"]
COPY --chown=root:root ["./config.php.template", "/root/.templates/"]
COPY --chown=root:root ["./base/moodle", "/root/.templates/moodle"]

RUN (chown -R www:www /var/lib/nginx 2>/dev/null || true) \
    && chmod 1700 /opt/*.sh \
    && (chown -R www:www /opt/*.sh 2>/dev/null || true) \
    && echo "America/Sao_Paulo" > /etc/timezone

ENTRYPOINT [ "/opt/entrypoint.sh" ]
